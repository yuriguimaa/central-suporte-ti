# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). Use SOMENTE a chave "anon"/"publishable".
# NUNCA coloque a chave service_role no frontend.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Personalização opcional da marca
VITE_APP_NAME=Called for Yuri
VITE_APP_SHORT_NAME=Called
