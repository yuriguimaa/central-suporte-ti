// Publicação na Cloudflare (Workers com arquivos estáticos).
// O site é 100% estático: o Worker só entrega o conteúdo da pasta dist/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "central-suporte-ti",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    // Rotas como /painel/chamados/12 abrem o index.html (React Router cuida do resto).
    "not_found_handling": "single-page-application"
  }
}
